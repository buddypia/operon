+#[test]
+fn probe_268_closing_the_tab_of_an_exited_session() {
+    let root = temporary_directory("probe-268-tab");
+    let mut app = test_app(root.join("store.json"));
+    app.page = Page::Sessions;
+    app.show_session_inspector = false;
+    let project_id = Uuid::new_v4();
+    app.store.projects.push(Project { id: project_id, path: root.clone(), name: "p".into(), added_at: now() });
+    let make = |app: &mut OperonApp, name: &str, status: SessionStatus| {
+        let mut s = test_session(Uuid::new_v4(), status);
+        s.project_id = project_id;
+        s.name = name.into();
+        s.tmux_name = managed_tmux_name(s.id);
+        let id = s.id;
+        app.store.sessions.push(s);
+        id
+    };
+    let live = make(&mut app, "live", SessionStatus::Active);
+    let dead = make(&mut app, "dead", SessionStatus::Active);
+    let ctx = egui::Context::default();
+    let frame = |app: &mut OperonApp| {
+        let _ = ctx.run(
+            egui::RawInput { screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1600.0, 820.0))), ..Default::default() },
+            |ctx| { egui::CentralPanel::default().show(ctx, |ui| app.ui_terminal_workspace(ui)); },
+        );
+    };
+    frame(&mut app);
+    app.open_session_in_terminal(dead);
+    frame(&mut app);
+    eprintln!("tabs before: {:?}", app.workspace.groups.iter().map(|g| g.tabs.clone()).collect::<Vec<_>>());
+    // pane exits: the poll marks it Exited
+    app.store.sessions.iter_mut().find(|s| s.id == dead).unwrap().status = SessionStatus::Exited;
+    frame(&mut app);
+    app.close_workspace_tab(&WorkspaceTab::Session(dead));
+    eprintln!("tabs right after close: {:?}", app.workspace.groups.iter().map(|g| g.tabs.clone()).collect::<Vec<_>>());
+    for _ in 0..3 { frame(&mut app); }
+    eprintln!("tabs after frames: {:?} selected={:?} dead={dead} live={live}", app.workspace.groups.iter().map(|g| g.tabs.clone()).collect::<Vec<_>>(), app.selected_session);
+    eprintln!("notice={:?}", app.notice);
+    fs::remove_dir_all(&root).ok();
+}
