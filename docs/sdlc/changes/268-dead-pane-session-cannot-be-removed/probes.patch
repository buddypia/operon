+#[test]
+pub(crate) fn probe_268_removing_an_exited_session_with_a_dead_pane() {
+    if !tool_available("tmux") {
+        return;
+    }
+    let root = temporary_root().join(format!("operon-probe-268-{}", Uuid::new_v4()));
+    fs::create_dir_all(&root).unwrap();
+    let session_id = Uuid::new_v4();
+    let tmux_name = format!("operon-probe268-{}", session_id.simple());
+    assert!(tmux_command()
+        .args(["new-session", "-d", "-s", &tmux_name, "sleep 0.5; exit 0"])
+        .status()
+        .unwrap()
+        .success());
+    configure_tmux_session(&tmux_name).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while tmux_observation(&tmux_name).state != TmuxState::Dead && Instant::now() < deadline {
+        thread::sleep(Duration::from_millis(50));
+    }
+    eprintln!("observation before: {:?}", tmux_observation(&tmux_name));
+    let mut session = test_session(session_id, SessionStatus::Exited);
+    session.tmux_name = tmux_name.clone();
+    let mut app = test_app(root.join("store.json"));
+    app.store.sessions.push(session);
+    app.request_session_removal(session_id);
+    wait_for_background_task(
+        &mut app,
+        &BackgroundKey::TerminalClose(session_id),
+        Duration::from_secs(15),
+    );
+    eprintln!("notice: {:?}", app.notice);
+    eprintln!("sessions left: {}", app.store.sessions.len());
+    eprintln!("observation after: {:?}", tmux_observation(&tmux_name));
+    assert!(app.store.sessions.is_empty());
+    fs::remove_dir_all(root).unwrap();
+}
