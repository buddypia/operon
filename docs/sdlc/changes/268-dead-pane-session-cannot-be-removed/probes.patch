+fn probe_268_clicking_the_tab_close_of_an_exited_session() {
+    let root = temporary_directory("probe-268-click");
+    let mut app = test_app(root.join("store.json"));
+    app.page = Page::Sessions;
+    app.show_session_inspector = false;
+    let project_id = Uuid::new_v4();
+    app.store.projects.push(Project { id: project_id, path: root.clone(), name: "p".into(), added_at: now() });
+    let make = |app: &mut OperonApp, name: &str, status: SessionStatus| {
+        let mut s = test_session(Uuid::new_v4(), status);
+        s.project_id = project_id;
+        s.name = name.into();
+        s.tmux_name = managed_tmux_name(s.id);
+        let id = s.id;
+        app.store.sessions.push(s);
+        id
+    };
+    let live = make(&mut app, "liveone", SessionStatus::Active);
+    let dead = make(&mut app, "deadone", SessionStatus::Active);
+    app.set_session_output(dead, "Pane is dead (status 0)\n".into(), None);
+    let ctx = egui::Context::default();
+    ctx.enable_accesskit();
+    let mut t = 0.0f64;
+    let mut frame = |app: &mut OperonApp, events: Vec<egui::Event>| {
+        t += 0.05;
+        ctx.run(
+            egui::RawInput { time: Some(t), events, screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1600.0, 820.0))), ..Default::default() },
+            |ctx| { egui::CentralPanel::default().show(ctx, |ui| app.ui_terminal_workspace(ui)); },
+        )
+    };
+    frame(&mut app, vec![]);
+    app.open_session_in_terminal(dead);
+    frame(&mut app, vec![]);
+    app.store.sessions.iter_mut().find(|s| s.id == dead).unwrap().status = SessionStatus::Exited;
+    let out = frame(&mut app, vec![]);
+    let update = out.platform_output.accesskit_update.expect("accesskit");
+    let mut closes = Vec::new();
+    let mut titles = Vec::new();
+    for (_, node) in &update.nodes {
+        let label = node.label().unwrap_or("").to_owned();
+        if let Some(b) = node.bounds() {
+            if label == ICON_CLOSE { closes.push(b); }
+            if b.y0 < 70.0 && !label.is_empty() { eprintln!("node {:?} {label:?} {b:?}", node.role()); }
+            if label.contains("deadone") || label.contains("liveone") { titles.push((label.clone(), b)); }
+        }
+    }
+    eprintln!("closes: {closes:?}");
+    eprintln!("titles: {titles:?}");
+    let target = closes.iter().max_by(|a, b| a.x0.partial_cmp(&b.x0).unwrap()).copied().unwrap();
+    let pos = egui::pos2(((target.x0 + target.x1) / 2.0) as f32, ((target.y0 + target.y1) / 2.0) as f32);
+    eprintln!("clicking {pos:?}");
+    frame(&mut app, vec![egui::Event::PointerMoved(pos)]);
+    frame(&mut app, vec![egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() }]);
+    frame(&mut app, vec![egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() }]);
+    for _ in 0..3 { frame(&mut app, vec![]); }
+    eprintln!("tabs after click: {:?} selected={:?} dead={dead} live={live}", app.workspace.groups.iter().map(|g| g.tabs.clone()).collect::<Vec<_>>(), app.selected_session);
+    eprintln!("notice={:?}", app.notice);
+    fs::remove_dir_all(&root).ok();
+}
