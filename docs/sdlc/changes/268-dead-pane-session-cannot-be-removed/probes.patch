+        for (_, node) in &u.nodes { if let Some(b) = node.bounds() { if b.y0 < 200.0 && b.x0 > 600.0 && b.x0 < 900.0 { eprintln!("near: {:?} {:?} {:?}", node.role(), node.label(), b); } } }
+        eprintln!("hover layer: {:?}", ctx.layer_id_at(pos));
+    }
+    frame(&mut app, vec![egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() }]);
+    thread::sleep(Duration::from_millis(60));
+    frame(&mut app, vec![egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() }]);
+    eprintln!("tabs right after click: {:?}", app.workspace.groups.iter().map(|g| g.tabs.clone()).collect::<Vec<_>>());
+    for _ in 0..80 { frame(&mut app, vec![]); thread::sleep(Duration::from_millis(30)); }
+    eprintln!("tabs after: {:?} selected={:?}", app.workspace.groups.iter().map(|g| g.tabs.clone()).collect::<Vec<_>>(), app.selected_session);
+    eprintln!("notice={:?}", app.notice);
+    for n in names { kill_tmux_session(&n); }
+    fs::remove_dir_all(&root).ok();
+}
